    /* ===== RESET ===== */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    /* ===== PAGE ===== */
    @page { size: A4; margin: 0; }

    body {
      font-family: 'Segoe UI', Arial, sans-serif;
      font-size: 9pt;
      color: #1a1a1a;
      background: #e8e8e8;
    }

    .page {
