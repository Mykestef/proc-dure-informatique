      background: #2b3a2b;
      color: #f0f0f0;
      padding: 8mm 6mm;
      display: flex;
      flex-direction: column;
      gap: 6mm;
    }

    .avatar-box {
      display: flex;
      justify-content: center;
      margin-bottom: 2mm;
    }

    .avatar-circle {
      width: 28mm; height: 28mm;
      border-radius: 50%;
      background: #c8f542;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14pt;
      font-weight: 900;
      color: #2b3a2b;
      letter-spacing: -0.05em;
      border: 2px solid rgba(255,255,255,0.2);
    }

    .sidebar-section { border-top: 1px solid rgba(255,255,255,0.15); padding-top: 4mm; }

    .sidebar-title {
      font-size: 7pt;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: #c8f542;
      font-weight: 700;
      margin-bottom: 2.5mm;
    }

    .contact-item {
      display: flex;
      align-items: flex-start;
      gap: 2mm;
      margin-bottom: 2mm;
      font-size: 8pt;
      color: #d0d0d0;
      line-height: 1.3;
      word-break: break-all;
    }

    .contact-icon { font-size: 9pt; flex-shrink: 0; margin-top: 0.5mm; }

    .skill-tag {
      display: inline-block;
      background: rgba(200,245,66,0.1);
      border: 1px solid rgba(200,245,66,0.25);
      color: #c8f542;
      font-size: 7.5pt;
      padding: 1.5mm 2.5mm;
      border-radius: 2px;
      margin: 1mm 1mm 0 0;
      font-weight: 500;
    }

    .lang-row { display: flex; justify-content: space-between; margin-bottom: 2mm; }
    .lang-name { font-size: 8pt; font-weight: 600; color: #f0f0f0; }
    .lang-level {
      font-size: 7pt;
      background: rgba(200,245,66,0.2);
      color: #c8f542;
      padding: 0.5mm 2mm;
      border-radius: 2px;
