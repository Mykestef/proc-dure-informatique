    .interest-list { font-size: 8pt; color: #b0b0b0; line-height: 1.9; }

    /* QR CODE ZONE */
    .qr-zone {
      border-top: 1px solid rgba(255,255,255,0.15);
      padding-top: 4mm;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2mm;
    }

    .qr-label {
      font-size: 6.5pt;
      color: #c8f542;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      text-align: center;
      font-weight: 700;
    }

    #qrcode {
      background: white;
      padding: 2mm;
      border-radius: 3px;
    }

    #qrcode canvas, #qrcode img {
      width: 22mm !important;
      height: 22mm !important;
    }

    .qr-url {
      font-size: 6pt;
      color: #888;
      text-align: center;
      word-break: break-all;
    }

    /* ===== MAIN ===== */
    .main {
      padding: 8mm 7mm 8mm 7mm;
      display: flex;
      flex-direction: column;
      gap: 5mm;
    }

    /* Name block */
    .name-block { border-bottom: 3px solid #2b3a2b; padding-bottom: 4mm; }

    .name-main {
      font-size: 22pt;
      font-weight: 900;
      color: #2b3a2b;
      letter-spacing: -0.03em;
      line-height: 1;
